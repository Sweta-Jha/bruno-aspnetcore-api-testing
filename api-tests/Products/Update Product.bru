meta {
  name: Update Product
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/products/{{productId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Wireless Mouse",
    "price": 34.99,
    "stock": 95
  }
}

assert {
  res.status: eq 200
  res.body.price: eq 34.99
  res.body.stock: eq 95
}

docs {
  Changes the price and stock, then checks the response has the new values.
}
