meta {
  name: Get Product By Id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/products/{{productId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.name: eq Wireless Mouse
}

tests {
  test("has exactly the product fields", function () {
    expect(res.body).to.have.all.keys("id", "name", "price", "stock");
  });
}

docs {
  Reads back the product that Create Product saved.
  The test checks the response shape, so a renamed or extra field fails the run.
}
