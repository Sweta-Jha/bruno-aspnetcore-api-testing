auth {
  mode: apikey
}

auth:apikey {
  key: X-Api-Key
  value: {{process.env.API_KEY}}
  placement: header
}

docs {
  Tests for the Product Catalog API.

  Every request sends the X-Api-Key header set here, because each request uses "auth: inherit".
  The key is read from API_KEY in api-tests/.env. This demo commits that file with a demo key
  so it works straight after a clone. In a real project, keep .env out of Git.
}
