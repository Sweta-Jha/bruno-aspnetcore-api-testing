auth {
  mode: apikey
}

auth:apikey {
  key: X-Api-Key
  value: {{process.env.API_KEY}}
  placement: header
}

docs {
  Tests for the Product Catalog API.

  Every request sends the X-Api-Key header set here, because each request uses "auth: inherit".
  The key is read from API_KEY in api-tests/.env (Git ignores that file), or from the
  API_KEY environment variable in CI. Copy .env.sample to .env to get started.
}
